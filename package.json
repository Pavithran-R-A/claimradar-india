{
  "name": "claimradar-india",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --workspace-concurrency 1 -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --check .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "crawler:daily": "pnpm --filter @claimradar/crawler dev -- daily",
    "crawler:source": "pnpm --filter @claimradar/crawler dev -- source",
    "crawler:health": "pnpm --filter @claimradar/crawler dev -- health",
    "crawler:crawl-status": "pnpm --filter @claimradar/crawler dev -- crawl-status",
    "crawler:preflight": "pnpm --filter @claimradar/crawler dev -- preflight",
    "preflight:staging": "node scripts/staging-preflight.mjs",
    "bootstrap:staging-sources": "pnpm --filter @claimradar/shared-types build && pnpm --filter @claimradar/source-registry build && node scripts/staging-source-bootstrap.mjs",
    "test:staging-bootstrap": "node --test scripts/staging-source-bootstrap.test.mjs",
    "test:staging-auth-runtime": "node --test scripts/staging-auth-runtime-qa.test.mjs",
    "test:route-inventory": "node scripts/generate-final-route-state-inventory.mjs && node --test scripts/final-route-state-inventory.test.mjs",
    "test:inventory-acceptance": "pnpm --filter @claimradar/crawler test -- --run acceptance",
    "test:browser-smoke": "node scripts/ci-browser-smoke.mjs",
    "verify:migrations": "node scripts/verify-migration-contract.mjs",
    "test:phase-4b-offline": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:phase-4b-acceptance": "node scripts/phase-4b-acceptance-runner.mjs",
    "verify:local-ingestion": "node scripts/verify-local-database-ingestion.mjs",
    "verify:local-idempotency": "node scripts/verify-local-live-source-idempotency.mjs",
    "report:inventory-validation": "pnpm --filter @claimradar/crawler dev -- inventory-report"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
